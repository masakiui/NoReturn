<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>あの日には、もう戻れない…</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DotGothic16&family=Share+Tech+Mono&display=swap');

    body {
      margin: 0;
      padding: 0;
      background-color: #050505;
      color: #e5e5e5;
      font-family: 'DotGothic16', monospace;
      user-select: none;
      overflow: hidden;
      touch-action: none;
      transition: filter 0.5s ease, background-color 0.5s ease;
    }

    /* レトロCRT風エフェクト */
    .crt-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.04));
      background-size: 100% 3px, 6px 100%;
      pointer-events: none;
      z-index: 50;
    }

    /* 色彩解放レベルに応じた画面エフェクト（モノクロ -> ビビッドサイケデリック） */
    .palette-stage-0 { filter: grayscale(100%) contrast(110%); }
    .palette-stage-1 { filter: grayscale(65%) sepia(20%) saturate(140%); }
    .palette-stage-2 { filter: grayscale(30%) saturate(220%) hue-rotate(15deg); }
    .palette-stage-3 { filter: grayscale(0%) saturate(300%) contrast(115%) hue-rotate(45deg); }
    .palette-stage-4 { filter: grayscale(0%) saturate(450%) contrast(130%) hue-rotate(120deg); }

    canvas {
      display: block;
      image-rendering: pixelated;
    }

    .retro-btn {
      background: #18181b;
      border: 2px solid #52525b;
      box-shadow: 3px 3px 0px #000;
      transition: all 0.08s ease;
    }
    .retro-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }

    /* レベルアップ（衰弱）演出ポップアップ */
    @keyframes levelup-flare {
      0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
      40% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
      80% { transform: translate(-50%, -50%) scale(1.0); opacity: 1; }
      100% { transform: translate(-50%, -60%) scale(0.9); opacity: 0; }
    }
    .levelup-banner {
      animation: levelup-flare 1.3s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }

    @keyframes dog-wiggle {
      0% { transform: scale(1, 1) rotate(0deg); }
      25% { transform: scale(0.85, 1.3) rotate(-20deg) translateY(-14px); }
      50% { transform: scale(1.25, 0.75) rotate(15deg) translateY(8px); }
      75% { transform: scale(0.8, 1.35) rotate(-10deg) translateY(-18px); }
      100% { transform: scale(1, 1) rotate(0deg); }
    }
    .dancing-dog {
      animation: dog-wiggle 0.38s infinite ease-in-out;
      transform-origin: bottom center;
    }
  </style>
</head>
<body id="game-body" class="palette-stage-0 flex flex-col items-center justify-center min-h-screen relative">
  <!-- CRT走査線フィルター -->
  <div class="crt-overlay"></div>

  <!-- レベルアップ時の派手なアナウンス -->
  <div id="levelup-popup" class="fixed top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-50 hidden text-center">
    <div class="text-3xl md:text-5xl font-black italic tracking-widest text-yellow-300 drop-shadow-[0_0_15px_rgba(234,179,8,1)] stroke-black">
      ★ LEVEL UP!! ★
    </div>
    <div class="text-xs md:text-sm font-bold bg-black/80 text-pink-400 px-4 py-1 mt-1 rounded border border-pink-500 inline-block">
      ※身体機能が著しく低下しました（弱体化）
    </div>
  </div>

  <!-- ゲームメインコンテナ -->
  <div class="relative w-full max-w-2xl h-screen max-h-[850px] flex flex-col justify-between p-2 md:p-4 box-border">
    <!-- ステータスバー -->
    <header id="ui-header" class="w-full flex justify-between items-center bg-zinc-900/90 border-2 border-zinc-700 p-2 text-xs md:text-sm z-20 backdrop-blur">
      <div class="flex items-center space-x-1">
        <span class="text-zinc-400">STAGE:</span>
        <span id="color-stage-badge" class="px-1.5 py-0.5 rounded text-[10px] bg-zinc-800 text-zinc-300 border border-zinc-600 font-mono">モノクローム</span>
      </div>
      <div>
        <span class="text-zinc-400">LV:</span>
        <span id="player-level" class="text-amber-400 font-bold ml-1">99 (英雄)</span>
      </div>
      <div>
        <span class="text-zinc-400">HP:</span>
        <span id="player-hp" class="text-red-400 font-bold ml-1">100/100</span>
      </div>
      <div>
        <span class="text-zinc-400">ATK:</span>
        <span id="player-atk" class="text-blue-400 font-bold ml-1">99</span>
      </div>
      <button id="header-share-btn" class="retro-btn px-2 py-0.5 text-[11px] bg-cyan-950 border-cyan-500 text-cyan-200">
        🔗共有
      </button>
    </header>

    <!-- キャンバス領域 -->
    <div class="relative flex-1 w-full my-2 bg-black border-2 border-zinc-800 overflow-hidden flex items-center justify-center">
      <canvas id="gameCanvas" class="w-full h-full"></canvas>

      <!-- シーン1: ノワール・バーカウンター対話ダイアログ -->
      <div id="bar-overlay" class="absolute inset-0 bg-black/75 flex flex-col justify-end p-4 md:p-6 transition-opacity duration-300 pointer-events-auto">
        <div class="bg-zinc-950/95 border-2 border-zinc-400 p-4 rounded shadow-2xl">
          <div class="flex items-center space-x-3 mb-2">
            <div class="w-8 h-8 rounded-full border border-zinc-400 flex items-center justify-center text-xs font-mono bg-zinc-800">🍸</div>
            <div class="text-sm text-zinc-300 font-bold">寡黙なマスター</div>
          </div>
          <p id="bar-text" class="text-sm md:text-base leading-relaxed text-zinc-100 min-h-[48px]"></p>
          <div class="mt-4 flex justify-end">
            <button id="bar-next-btn" class="retro-btn px-5 py-2 text-xs md:text-sm text-white font-bold tracking-widest hover:border-white">
              次へ [CLICK]
            </button>
          </div>
        </div>
      </div>

      <!-- 死に際セリフ・親父ギャグトースト -->
      <div id="joke-toast" class="absolute top-4 left-1/2 -translate-x-1/2 bg-zinc-950/90 border-2 border-yellow-500 text-yellow-300 text-xs md:text-sm px-4 py-2 rounded shadow-2xl pointer-events-none transition-all duration-300 opacity-0 translate-y-[-10px] text-center z-30 max-w-[90%]">
        <span id="joke-toast-name" class="font-bold block text-[10px] text-pink-400">オッカナデッドの断末魔</span>
        <span id="joke-toast-text"></span>
      </div>

      <!-- ゲームオーバー画面 -->
      <div id="gameover-screen" class="absolute inset-0 bg-zinc-950/95 flex flex-col items-center justify-center p-4 z-40 hidden">
        <div class="text-red-500 font-extrabold text-3xl md:text-4xl tracking-widest mb-1 drop-shadow-[0_0_10px_rgba(239,68,68,0.8)]">
          G A M E  O V E R
        </div>
        <p class="text-zinc-400 text-xs mb-2">レベルが上がりすぎて肉体が限界を迎えました。</p>

        <!-- 満面の笑みで踊る犬 -->
        <div class="w-36 h-36 my-1 dancing-dog flex items-center justify-center">
          <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_15px_rgba(250,204,21,0.6)]">
            <polygon points="25,35 15,10 40,25" fill="#facc15" stroke="#713f12" stroke-width="2"/>
            <polygon points="75,35 85,10 60,25" fill="#facc15" stroke="#713f12" stroke-width="2"/>
            <ellipse cx="50" cy="75" rx="22" ry="18" fill="#fde047" stroke="#713f12" stroke-width="2"/>
            <circle cx="50" cy="45" r="26" fill="#fef08a" stroke="#713f12" stroke-width="2"/>
            <path d="M 33 42 Q 40 33 45 42" fill="transparent" stroke="#1c1917" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M 55 42 Q 60 33 67 42" fill="transparent" stroke="#1c1917" stroke-width="3.5" stroke-linecap="round"/>
            <ellipse cx="32" cy="49" rx="4" ry="2.5" fill="#f87171" opacity="0.9"/>
            <ellipse cx="68" cy="49" rx="4" ry="2.5" fill="#f87171" opacity="0.9"/>
            <polygon points="47,48 53,48 50,52" fill="#1c1917"/>
            <path d="M 40 54 Q 50 74 60 54 Z" fill="#dc2626" stroke="#1c1917" stroke-width="2"/>
            <path d="M 45 61 Q 50 68 55 61" fill="#f43f5e"/>
            <path d="M 30 75 Q 12 65 20 85" stroke="#713f12" stroke-width="4" stroke-linecap="round"/>
            <path d="M 70 75 Q 88 65 80 85" stroke="#713f12" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- 意味不明な健康アドバイス -->
        <div class="w-full max-w-md bg-zinc-900/90 border border-yellow-500/80 p-3 rounded my-2 text-center shadow-lg">
          <div class="text-[10px] text-yellow-400 font-bold tracking-wider mb-1">【 今日の健康ひとくちメモ 】</div>
          <p id="absurd-advice" class="text-xs md:text-sm text-yellow-100 leading-normal"></p>
        </div>

        <div class="flex gap-3 mt-3">
          <button id="retry-btn" class="retro-btn px-6 py-2 bg-red-950 border-red-500 text-white font-bold text-sm tracking-wider">
            最初から（解脱）
          </button>
          <button id="share-game-btn" class="retro-btn px-4 py-2 bg-blue-950 border-blue-500 text-blue-200 font-bold text-sm">
            🔗 友人に布教
          </button>
        </div>
      </div>
    </div>

    <!-- モバイル／タッチ仮想コントローラー -->
    <footer class="w-full bg-zinc-900 border-2 border-zinc-700 p-2 flex justify-between items-center text-xs">
      <div class="flex gap-2">
        <button id="btn-left" class="retro-btn w-12 h-12 flex items-center justify-center text-lg active:bg-zinc-700">◀</button>
        <button id="btn-right" class="retro-btn w-12 h-12 flex items-center justify-center text-lg active:bg-zinc-700">▶</button>
      </div>
      <div class="text-[11px] text-zinc-400 text-center px-1">
        移動: [←][→] / [A][D]<br>攻撃: [スペース]
      </div>
      <div>
        <button id="btn-attack" class="retro-btn px-5 h-12 bg-red-950/90 border-red-600 text-red-200 font-bold active:bg-red-800">
          ATTACK
        </button>
      </div>
    </footer>
  </div>

  <script>
    /* ========================================================
       オーディオ生成 (Web Audio API)
       ======================================================== */
    let audioCtx = null;
    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playSfx(type) {
      if (!audioCtx) return;
      const now = audioCtx.currentTime;

      if (type === 'hit') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(30, now + 0.12);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 0.12);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.12);
      } else if (type === 'attack') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(380, now);
        osc.frequency.exponentialRampToValueAtTime(100, now + 0.09);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 0.09);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      } else if (type === 'delevel') {
        // ファンファーレの皮を被った脱力トーン
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(587.33, now);
        osc.frequency.setValueAtTime(523.25, now + 0.08);
        osc.frequency.setValueAtTime(440.00, now + 0.16);
        osc.frequency.setValueAtTime(293.66, now + 0.26);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.45);
      } else if (type === 'talk') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(160 + Math.random() * 80, now);
        gain.gain.setValueAtTime(0.04, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.04);
      }
    }

    let gameOverBgmInterval = null;
    function startSurrealDogBgm() {
      if (!audioCtx) return;
      stopSurrealDogBgm();
      const weirdNotes = [261.63, 311.13, 369.99, 415.30, 523.25, 622.25, 739.99];
      let step = 0;

      gameOverBgmInterval = setInterval(() => {
        if (!audioCtx) return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = step % 2 === 0 ? 'sine' : 'sawtooth';
        const note = weirdNotes[(step * 3 + (step % 5)) % weirdNotes.length];
        osc.frequency.setValueAtTime(note, now);
        osc.frequency.exponentialRampToValueAtTime(note * 0.7, now + 0.18);

        gain.gain.setValueAtTime(0.12, now);
        gain.gain.linearRampToValueAtTime(0.001, now + 0.18);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.2);

        step++;
      }, 160);
    }

    function stopSurrealDogBgm() {
      if (gameOverBgmInterval) {
        clearInterval(gameOverBgmInterval);
        gameOverBgmInterval = null;
      }
    }

    /* ========================================================
       ゲームデータ & テキストデータベース
       ======================================================== */
    const DAD_JOKES = [
      "「アルミ缶の上にあるミカン……無念…」",
      "「布団が……ふっとんだぁぁあ！」",
      "「電話に出んわ…ガクッ」",
      "「イクラはいくら？…冥土の土産に教えてくれ…」",
      "「校長先生、絶好調……バタッ」",
      "「トイレに行っといれ…と言われたのに…」",
      "「そんなバナナ……（消滅）」",
      "「スキーが……すきー……」"
    ];

    const ABSURD_ADVICES = [
      "「ヨーグルトにみじん切りした生の玉ねぎを入れて一晩寝かせると、血液がサラサラになる気がします。」",
      "「朝起きてすぐに冷水を鼻から吸うと、二度寝の確率が著しく低下します。」",
      "「納豆を400回かき混ぜたあと、さらに虚空を見つめると集中力が高まります。」",
      "「部屋の四隅にキャベツを置くと、Wi-Fiの電波が優しくなります。」",
      "「バナナの皮をじっと見つめて深呼吸すると、特に何も起こりません。」",
      "「寝る前にパジャマの裏表を逆にすると、悪夢が混乱して逃げ出します。」"
    ];

    const BAR_DIALOGUE = [
      "……いらっしゃい。今夜はひどい雨だ。",
      "この街の掟を知っているか？ ここでは『成長』などという幻想は呪いでしかない。",
      "敵を倒し、レベルが上がるほど……お前は衰え、弱り果てていく。",
      "そして世界は……薄気味悪いくらい極彩色に染まっていくのさ。",
      "それでも奥の扉を開けるかい？ グラスを置きな。"
    ];

    /* ========================================================
       ゲームステート
       ======================================================== */
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const bodyElem = document.getElementById('game-body');

    let currentScene = 'BAR';
    let dialogueIndex = 0;
    let colorStage = 0; // 0: モノクロ -> 4: 超極彩色サイケデリック
    let discoBeat = 0;

    let player = {
      x: 80,
      y: 0,
      width: 24,
      height: 36,
      vx: 0,
      maxHp: 100,
      hp: 100,
      level: 99,
      atk: 99,
      speed: 5.2,
      facing: 1,
      isAttacking: false,
      attackTimer: 0,
      invulnerableTimer: 0
    };

    let enemies = [];
    let enemySpawnTimer = 0;
    let groundY = 0;

    const keys = { left: false, right: false };

    function resizeCanvas() {
      const container = canvas.parentElement;
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
      groundY = canvas.height - 42;
      player.y = groundY - player.height;
    }
    window.addEventListener('resize', resizeCanvas);

    /* バー会話進行 */
    const barOverlay = document.getElementById('bar-overlay');
    const barText = document.getElementById('bar-text');
    const barNextBtn = document.getElementById('bar-next-btn');

    function updateDialogue() {
      if (dialogueIndex < BAR_DIALOGUE.length) {
        barText.textContent = BAR_DIALOGUE[dialogueIndex];
        playSfx('talk');
      } else {
        barOverlay.classList.add('opacity-0');
        setTimeout(() => {
          barOverlay.classList.add('hidden');
          currentScene = 'GAMEPLAY';
        }, 300);
      }
    }

    barNextBtn.addEventListener('click', () => {
      initAudio();
      dialogueIndex++;
      updateDialogue();
    });

    /* デレベル & 色彩解放処理 */
    function triggerDelevel() {
      if (player.level > 1) {
        player.level -= 18;
        if (player.level < 1) player.level = 1;
      }

      // レベル低下に比例したパラメータ急減
      player.atk = Math.max(3, Math.floor(player.atk * 0.62));
      player.speed = Math.max(1.3, player.speed * 0.82);
      player.maxHp = Math.max(15, Math.floor(player.maxHp * 0.72));
      if (player.hp > player.maxHp) player.hp = player.maxHp;

      // 色彩解放ステージ更新 (モノクロ -> ネオン極彩色へ)
      if (player.level <= 15) {
        colorStage = 4;
      } else if (player.level <= 35) {
        colorStage = 3;
      } else if (player.level <= 60) {
        colorStage = 2;
      } else if (player.level <= 85) {
        colorStage = 1;
      } else {
        colorStage = 0;
      }

      // 画面フィルタークラス更新
      bodyElem.className = `palette-stage-${colorStage} flex flex-col items-center justify-center min-h-screen relative`;

      // 画面上部バッジ更新
      const stageBadge = document.getElementById('color-stage-badge');
      const stageNames = ["モノクローム", "淡きノスタルジア", "ネオン侵食", "ビビッド狂気", "サイケデリック涅槃"];
      const stageColors = ["text-zinc-400 border-zinc-600", "text-amber-300 border-amber-600", "text-cyan-300 border-cyan-500", "text-pink-400 border-pink-500", "text-fuchsia-300 border-fuchsia-400 animate-pulse"];
      stageBadge.textContent = stageNames[colorStage];
      stageBadge.className = `px-1.5 py-0.5 rounded text-[10px] bg-zinc-900 border font-bold ${stageColors[colorStage]}`;

      // LEVEL UP 派手ポップアップ表示
      showLevelUpPopup();
      playSfx('delevel');
      updateUi();
    }

    function showLevelUpPopup() {
      const popup = document.getElementById('levelup-popup');
      popup.classList.remove('hidden', 'levelup-banner');
      void popup.offsetWidth; // リフロー
      popup.classList.add('levelup-banner');
      setTimeout(() => {
        popup.classList.add('hidden');
      }, 1300);
    }

    function updateUi() {
      document.getElementById('player-level').textContent = `${player.level} (${getRankName(player.level)})`;
      document.getElementById('player-hp').textContent = `${Math.ceil(player.hp)}/${player.maxHp}`;
      document.getElementById('player-atk').textContent = `${player.atk}`;
    }

    function getRankName(lvl) {
      if (lvl >= 85) return "超人";
      if (lvl >= 60) return "脱力系一般人";
      if (lvl >= 35) return "慢性疲労";
      if (lvl >= 15) return "生まれたての小鹿";
      return "風前の灯火";
    }

    /* 遺言トースト表示 */
    let toastTimeout = null;
    function showJokeToast(joke) {
      const toast = document.getElementById('joke-toast');
      const textElem = document.getElementById('joke-toast-text');
      textElem.textContent = joke;
      toast.classList.remove('opacity-0', 'translate-y-[-10px]');
      toast.classList.add('opacity-100', 'translate-y-0');

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-[-10px]');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2300);
    }

    /* 敵の生成 */
    function spawnEnemy() {
      const fromRight = Math.random() > 0.3;
      const x = fromRight ? canvas.width + 25 : -30;
      enemies.push({
        x: x,
        y: groundY - 34,
        width: 22,
        height: 34,
        hp: 35 + (100 - player.level) * 1.2,
        speed: 1.1 + Math.random() * 0.8,
        facing: fromRight ? -1 : 1,
        colorHue: Math.floor(Math.random() * 360)
      });
    }

    /* ゲームオーバー */
    function triggerGameOver() {
      currentScene = 'GAMEOVER';
      document.getElementById('gameover-screen').classList.remove('hidden');

      const randomAdvice = ABSURD_ADVICES[Math.floor(Math.random() * ABSURD_ADVICES.length)];
      document.getElementById('absurd-advice').textContent = randomAdvice;

      startSurrealDogBgm();
    }

    /* リトライ */
    document.getElementById('retry-btn').addEventListener('click', () => {
      stopSurrealDogBgm();
      document.getElementById('gameover-screen').classList.add('hidden');

      player.level = 99;
      player.maxHp = 100;
      player.hp = 100;
      player.atk = 99;
      player.speed = 5.2;
      player.x = 80;
      player.y = groundY - player.height;
      player.invulnerableTimer = 0;
      player.isAttacking = false;
      enemies = [];
      colorStage = 0;
      bodyElem.className = `palette-stage-0 flex flex-col items-center justify-center min-h-screen relative`;
      
      const stageBadge = document.getElementById('color-stage-badge');
      stageBadge.textContent = "モノクローム";
      stageBadge.className = "px-1.5 py-0.5 rounded text-[10px] bg-zinc-800 text-zinc-300 border border-zinc-600 font-mono";

      updateUi();
      currentScene = 'GAMEPLAY';
    });

    /* リンク共有ロジック (クリップボードコピー) */
    function shareUrl() {
      const dummy = document.createElement('textarea');
      dummy.value = window.location.href;
      document.body.appendChild(dummy);
      dummy.select();
      try {
        document.execCommand('copy');
        showJokeToast('🔗 ゲームURLをクリップボードにコピーしました！');
      } catch (e) {
        showJokeToast('URLのコピーに失敗しました。アドレスバーのURLをお使いください。');
      }
      document.body.removeChild(dummy);
    }
    document.getElementById('header-share-btn').addEventListener('click', shareUrl);
    document.getElementById('share-game-btn').addEventListener('click', shareUrl);

    /* ========================================================
       操作入力
       ======================================================== */
    window.addEventListener('keydown', (e) => {
      initAudio();
      if (e.code === 'ArrowLeft' || e.key === 'a') keys.left = true;
      if (e.code === 'ArrowRight' || e.key === 'd') keys.right = true;
      if (e.code === 'Space') {
        performAttack();
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.key === 'a') keys.left = false;
      if (e.code === 'ArrowRight' || e.key === 'd') keys.right = false;
    });

    function performAttack() {
      if (currentScene !== 'GAMEPLAY' || player.isAttacking) return;
      player.isAttacking = true;
      player.attackTimer = 14;
      playSfx('attack');
    }

    const bindTouchBtn = (id, onDown, onUp) => {
      const el = document.getElementById(id);
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        initAudio();
        onDown();
      });
      el.addEventListener('pointerup', (e) => {
        e.preventDefault();
        if (onUp) onUp();
      });
      el.addEventListener('pointerleave', (e) => {
        e.preventDefault();
        if (onUp) onUp();
      });
    };

    bindTouchBtn('btn-left', () => { keys.left = true; }, () => { keys.left = false; });
    bindTouchBtn('btn-right', () => { keys.right = true; }, () => { keys.right = false; });
    bindTouchBtn('btn-attack', () => { performAttack(); });

    /* ========================================================
       描画ロジック (色彩豊かに狂っていく背景 & キャラクター)
       ======================================================== */
    function drawBarScene() {
      ctx.fillStyle = '#0f0f12';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#27272a';
      ctx.fillRect(40, 50, canvas.width - 80, 8);
      ctx.fillRect(40, 110, canvas.width - 80, 8);

      for (let i = 60; i < canvas.width - 80; i += 28) {
        ctx.fillStyle = (i % 56 === 0) ? '#52525b' : '#3f3f46';
        ctx.fillRect(i, 26, 12, 24);
        ctx.fillRect(i + 4, 86, 10, 24);
      }

      ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.beginPath();
      ctx.moveTo(canvas.width / 2, 0);
      ctx.lineTo(canvas.width / 2 - 120, canvas.height);
      ctx.lineTo(canvas.width / 2 + 120, canvas.height);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = '#18181b';
      ctx.fillRect(0, groundY - 15, canvas.width, 35);
      ctx.fillStyle = '#27272a';
      ctx.fillRect(0, groundY - 18, canvas.width, 3);

      ctx.fillStyle = '#e4e4e7';
      ctx.fillRect(canvas.width / 2 - 20, groundY - 28, 8, 10);
      ctx.fillStyle = '#71717a';
      ctx.fillRect(canvas.width / 2 - 18, groundY - 18, 4, 3);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(canvas.width / 2 - 80, groundY - 48, 18, 30);
      ctx.fillStyle = '#a1a1aa';
      ctx.fillRect(canvas.width / 2 - 84, groundY - 54, 26, 6);
      ctx.fillRect(canvas.width / 2 - 78, groundY - 62, 14, 8);
    }

    function drawGameplay() {
      discoBeat += 0.05;

      // ステージが進むほど背景がカラフルなネオン市松模様や光に変化
      if (colorStage === 0) {
        ctx.fillStyle = '#0a0a0c';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      } else {
        const bgHue = (discoBeat * 20 + colorStage * 60) % 360;
        ctx.fillStyle = `hsl(${bgHue}, 40%, 6%)`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // サイケデリックなディスコブロックグリッド
        if (colorStage >= 2) {
          const tileSize = 32;
          for (let x = 0; x < canvas.width; x += tileSize) {
            for (let y = 0; y < groundY; y += tileSize) {
              if ((x / tileSize + y / tileSize) % 2 === 0) {
                ctx.fillStyle = `hsla(${(bgHue + x + y) % 360}, 80%, 50%, ${0.03 * colorStage})`;
                ctx.fillRect(x, y, tileSize, tileSize);
              }
            }
          }
        }
      }

      // 地面
      if (colorStage <= 1) {
        ctx.fillStyle = '#1c1917';
        ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);
        ctx.fillStyle = '#44403c';
        ctx.fillRect(0, groundY, canvas.width, 3);
      } else {
        // 色彩豊かなネオンフロア
        const floorHue = (discoBeat * 50) % 360;
        ctx.fillStyle = `hsl(${floorHue}, 70%, 15%)`;
        ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);
        ctx.fillStyle = `hsl(${(floorHue + 90) % 360}, 100%, 60%)`;
        ctx.fillRect(0, groundY, canvas.width, 4);
      }

      // 敵（オッカナデッド）
      enemies.forEach((enemy) => {
        if (colorStage === 0) {
          ctx.fillStyle = '#57534e';
          ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);
          ctx.fillStyle = '#ef4444';
          const eyeOffsetX = enemy.facing === 1 ? enemy.width - 6 : 2;
          ctx.fillRect(enemy.x + eyeOffsetX, enemy.y + 6, 4, 3);
        } else {
          // 色彩解放時はカラフルなゾンビ達に変化
          ctx.fillStyle = `hsl(${enemy.colorHue}, 80%, 45%)`;
          ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);
          ctx.fillStyle = '#ffffff';
          const eyeOffsetX = enemy.facing === 1 ? enemy.width - 6 : 2;
          ctx.fillRect(enemy.x + eyeOffsetX, enemy.y + 6, 5, 4);
          ctx.fillStyle = '#000000';
          ctx.fillRect(enemy.x + eyeOffsetX + (enemy.facing === 1 ? 2 : 0), enemy.y + 7, 2, 2);
        }
      });

      // プレイヤー
      if (player.invulnerableTimer % 4 < 2) {
        // プレイヤー自身も弱体化するほど色がド派手＆滑稽に
        if (colorStage === 0) {
          ctx.fillStyle = '#f4f4f5';
          ctx.fillRect(player.x, player.y, player.width, player.height);
          ctx.fillStyle = '#18181b';
          ctx.fillRect(player.x - 3, player.y - 4, player.width + 6, 5);
          ctx.fillRect(player.x + 2, player.y - 12, player.width - 4, 8);
        } else {
          // レベルが下がるとピンクやシアンの派手なパジャマ風スタイルに変貌
          ctx.fillStyle = colorStage >= 3 ? '#f43f5e' : '#38bdf8';
          ctx.fillRect(player.x, player.y, player.width, player.height);
          // ネオン水玉模様
          ctx.fillStyle = '#fef08a';
          ctx.fillRect(player.x + 4, player.y + 12, 4, 4);
          ctx.fillRect(player.x + 14, player.y + 22, 4, 4);

          // コミカルな帽子
          ctx.fillStyle = '#a855f7';
          ctx.fillRect(player.x - 2, player.y - 4, player.width + 4, 5);
          ctx.fillRect(player.x + 4, player.y - 12, player.width - 8, 8);
        }

        // プレイヤーの目
        ctx.fillStyle = '#000';
        const pEyeX = player.facing === 1 ? player.x + player.width - 6 : player.x + 3;
        ctx.fillRect(pEyeX, player.y + 6, 3, 3);
      }

      // 斬撃エフェクト (レベル99時は巨大、デレベル後は小さくショボくなる)
      if (player.isAttacking) {
        const attackScale = Math.max(0.4, player.level / 99);
        const slashW = 32 * attackScale;
        const slashH = 22 * attackScale;
        const slashX = player.facing === 1 ? player.x + player.width : player.x - slashW;

        if (colorStage === 0) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        } else {
          ctx.fillStyle = `hsl(${(discoBeat * 100) % 360}, 100%, 65%)`;
        }
        ctx.fillRect(slashX, player.y + 10 - slashH / 4, slashW, slashH);
      }
    }

    /* ========================================================
       ループ
       ======================================================== */
    function gameLoop() {
      if (currentScene === 'BAR') {
        drawBarScene();
      } else if (currentScene === 'GAMEPLAY') {
        if (keys.left) {
          player.vx = -player.speed;
          player.facing = -1;
        } else if (keys.right) {
          player.vx = player.speed;
          player.facing = 1;
        } else {
          player.vx = 0;
        }

        player.x += player.vx;
        if (player.x < 10) player.x = 10;
        if (player.x > canvas.width - player.width - 10) player.x = canvas.width - player.width - 10;

        if (player.isAttacking) {
          player.attackTimer--;
          if (player.attackTimer <= 0) {
            player.isAttacking = false;
          }

          const attackScale = Math.max(0.4, player.level / 99);
          const hitBox = {
            x: player.facing === 1 ? player.x + player.width : player.x - (32 * attackScale),
            y: player.y + 4,
            width: 32 * attackScale,
            height: 24
          };

          enemies.forEach((enemy, idx) => {
            if (
              hitBox.x < enemy.x + enemy.width &&
              hitBox.x + hitBox.width > enemy.x &&
              hitBox.y < enemy.y + enemy.height &&
              hitBox.y + hitBox.height > enemy.y
            ) {
              enemy.hp -= player.atk;
              playSfx('hit');

              if (enemy.hp <= 0) {
                const joke = DAD_JOKES[Math.floor(Math.random() * DAD_JOKES.length)];
                showJokeToast(joke);
                enemies.splice(idx, 1);
                triggerDelevel();
              }
            }
          });
        }

        if (player.invulnerableTimer > 0) {
          player.invulnerableTimer--;
        }

        enemySpawnTimer++;
        if (enemySpawnTimer > 95) {
          spawnEnemy();
          enemySpawnTimer = 0;
        }

        enemies.forEach((enemy) => {
          if (enemy.x < player.x) {
            enemy.x += enemy.speed;
            enemy.facing = 1;
          } else {
            enemy.x -= enemy.speed;
            enemy.facing = -1;
          }

          if (
            player.invulnerableTimer <= 0 &&
            player.x < enemy.x + enemy.width &&
            player.x + player.width > enemy.x &&
            player.y < enemy.y + enemy.height &&
            player.y + player.height > enemy.y
          ) {
            player.hp -= 20;
            player.invulnerableTimer = 35;
            playSfx('hit');
            updateUi();

            if (player.hp <= 0) {
              triggerGameOver();
            }
          }
        });

        drawGameplay();
      }

      requestAnimationFrame(gameLoop);
    }

    window.onload = function () {
      resizeCanvas();
      updateUi();
      updateDialogue();
      requestAnimationFrame(gameLoop);
    };
  </script>
</body>
